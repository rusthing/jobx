# `pnpm build` 自动读取本文件（Vite 的 production 模式）。
# 临时换部署位置不用改这里：命令行环境变量优先级更高，例如
#   PUBLIC_BASE=/jobx-web-test/ pnpm build

# 页面挂载路径，必须与 nginx 的 location 完全一致（注意末尾斜杠）。
# 它同时决定 index.html 里 /assets/* 的前缀和前端路由的 basename。
PUBLIC_BASE=/jobx-web/

# 接口前缀。与页面同源，由 nginx 把 /jobx-svr/ 反代到 jobx-svr:9001 并剥掉前缀；
# 后端路由本身是 /jobx/job/*，没有 /jobx-svr 这一层。
VITE_API_BASE=/jobx-svr
